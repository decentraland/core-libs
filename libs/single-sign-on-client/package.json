{
  "name": "@dcl/single-sign-on-client",
  "version": "3.0.1",
  "description": "Code that abstracts interaction with the single sign on iframe.",
  "author": "Decentraland",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decentraland/core-libs.git",
    "directory": "libs/single-sign-on-client"
  },
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "dev": "node ../../scripts/build-package.mjs --watch",
    "clean": "rm -rf dist",
    "test": "jest",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts'",
    "lint:fix": "eslint --fix 'src/**/*.ts' 'test/**/*.ts'"
  },
  "keywords": [
    "single-sign-on",
    "sso",
    "identity",
    "decentraland"
  ],
  "dependencies": {
    "@dcl/crypto": "workspace:*"
  },
  "devDependencies": {
    "@dcl/eslint-config": "^3.1.0",
    "eslint": "^9.39.5",
    "jest-environment-jsdom": "^30.0.2",
    "typescript": "^5.9.3",
    "esbuild": "^0.27.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
