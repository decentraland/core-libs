{
  "name": "decentraland-crypto-fetch",
  "version": "2.0.0",
  "description": "Make requests signed using a Decentraland Identity",
  "author": "Decentraland",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decentraland/core-libs.git",
    "directory": "libs/crypto-fetch"
  },
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "dev": "node ../../scripts/build-package.mjs --watch",
    "clean": "rm -rf dist",
    "test": "jest",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts'",
    "lint:fix": "eslint --fix 'src/**/*.ts' 'test/**/*.ts'"
  },
  "keywords": [
    "fetch",
    "http",
    "signed",
    "decentraland"
  ],
  "dependencies": {
    "@dcl/crypto": "workspace:*"
  },
  "devDependencies": {
    "@dcl/eslint-config": "^3.1.0",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "esbuild": "^0.27.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
