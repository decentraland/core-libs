{
  "name": "@dcl/crypto-middleware",
  "version": "1.0.0",
  "description": "Multi-framework authentication middleware for Decentraland signed requests",
  "author": "Decentraland",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "jest",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts'",
    "lint:fix": "eslint --fix 'src/**/*.ts' 'test/**/*.ts'"
  },
  "keywords": [
    "decentraland",
    "authentication",
    "middleware",
    "express",
    "koa",
    "passport",
    "well-known-components"
  ],
  "dependencies": {
    "@dcl/crypto": "workspace:*",
    "@well-known-components/interfaces": "^1.4.3"
  },
  "peerDependencies": {
    "express": "^4.0.0 || ^5.0.0",
    "koa": "^2.0.0",
    "passport-strategy": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "koa": {
      "optional": true
    },
    "passport-strategy": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dcl/eslint-config": "^2.4.3",
    "eslint": "^8.57.1",
    "@types/express": "^4.17.13",
    "@types/koa": "^2.13.4",
    "@types/passport-strategy": "^0.2.35",
    "@well-known-components/fetch-component": "^2.0.2",
    "express": "^4.18.2",
    "koa": "^2.13.3",
    "passport-strategy": "^1.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
