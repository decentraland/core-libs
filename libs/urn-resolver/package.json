{
  "name": "@dcl/urn-resolver",
  "version": "3.6.1",
  "description": "URN resolver for Decentraland assets",
  "author": "Decentraland",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "./update-contracts.sh",
    "build": "node ../../scripts/build-package.mjs",
    "dev": "node ../../scripts/build-package.mjs --watch",
    "clean": "rm -rf dist",
    "test": "jest",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts'",
    "lint:fix": "eslint --fix 'src/**/*.ts' 'test/**/*.ts'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decentraland/core-libs.git",
    "directory": "libs/urn-resolver"
  },
  "keywords": [
    "decentraland",
    "urn",
    "resolver"
  ],
  "dependencies": {},
  "devDependencies": {
    "@dcl/eslint-config": "^3.1.0",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "urn-lib": "^2.0.0",
    "esbuild": "^0.27.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
