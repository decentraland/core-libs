{
  "name": "@dcl/hashing",
  "version": "1.1.0",
  "description": "Hashing functions to calculate Decentraland Content Identifiers",
  "author": "Decentraland",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "typings": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.mjs",
      "require": "./dist/node.js"
    },
    "./ADR32": {
      "types": "./dist/ADR32.d.ts",
      "import": "./dist/ADR32.mjs",
      "require": "./dist/ADR32.js"
    },
    "./ADR62": {
      "types": "./dist/ADR62.d.ts",
      "import": "./dist/ADR62.mjs",
      "require": "./dist/ADR62.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --emitDeclarationOnly && esbuild src/index.ts src/node.ts src/ADR32.ts src/ADR62.ts --bundle --platform=node --format=cjs --outdir=dist --external:node:* --sourcemap && esbuild src/index.ts src/node.ts src/ADR32.ts src/ADR62.ts --bundle --platform=neutral --format=esm --outdir=dist --out-extension:.js=.mjs --packages=external --sourcemap",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "pnpm build && jest",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts'",
    "lint:fix": "eslint --fix 'src/**/*.ts' 'test/**/*.ts'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decentraland/core-libs.git",
    "directory": "libs/hashing"
  },
  "keywords": [
    "decentraland",
    "hashing",
    "cid",
    "ipfs"
  ],
  "dependencies": {
    "@ipld/dag-pb": "^4.1.5",
    "@noble/hashes": "^1.8.0",
    "ethereum-cryptography": "^3.2.0",
    "ipfs-unixfs": "^12.0.2",
    "multiformats": "^13.4.2"
  },
  "devDependencies": {
    "@dcl/eslint-config": "^2.4.3",
    "esbuild": "^0.27.0",
    "eslint": "^8.57.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
