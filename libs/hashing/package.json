{
  "name": "@dcl/hashing",
  "version": "1.2.0",
  "description": "Hashing functions to calculate Decentraland Content Identifiers",
  "author": "Decentraland",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "typings": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.mts",
        "default": "./dist/node.mjs"
      },
      "require": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      }
    },
    "./ADR32": {
      "import": {
        "types": "./dist/ADR32.d.mts",
        "default": "./dist/ADR32.mjs"
      },
      "require": {
        "types": "./dist/ADR32.d.ts",
        "default": "./dist/ADR32.js"
      }
    },
    "./ADR62": {
      "import": {
        "types": "./dist/ADR62.d.mts",
        "default": "./dist/ADR62.mjs"
      },
      "require": {
        "types": "./dist/ADR62.d.ts",
        "default": "./dist/ADR62.js"
      }
    }
  },
  "files": [
    "dist/index.*",
    "dist/node.*",
    "dist/ADR32.*",
    "dist/ADR62.*",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "dev": "node ../../scripts/build-package.mjs --watch",
    "clean": "rm -rf dist",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts'",
    "lint:fix": "eslint --fix 'src/**/*.ts' 'test/**/*.ts'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decentraland/core-libs.git",
    "directory": "libs/hashing"
  },
  "keywords": [
    "decentraland",
    "hashing",
    "cid",
    "ipfs"
  ],
  "dependencies": {
    "@ipld/dag-pb": "^4.1.5",
    "@noble/hashes": "^2.2.0",
    "ipfs-unixfs": "^12.0.2",
    "multiformats": "^13.4.2"
  },
  "devDependencies": {
    "@dcl/eslint-config": "^3.1.0",
    "blockstore-core": "^5.0.4",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.5",
    "ipfs-unixfs-importer": "^15.4.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "buildConfig": {
    "bundleCjsDependencies": true
  },
  "typesVersions": {
    "*": {
      "node": [
        "./dist/node.d.ts"
      ],
      "ADR32": [
        "./dist/ADR32.d.ts"
      ],
      "ADR62": [
        "./dist/ADR62.d.ts"
      ]
    }
  }
}
