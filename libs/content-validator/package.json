{
  "name": "@dcl/content-validator",
  "version": "7.4.2",
  "description": "Catalyst content validations",
  "author": "Decentraland",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "dev": "node ../../scripts/build-package.mjs --watch",
    "clean": "rm -rf dist",
    "test": "jest",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts'",
    "lint:fix": "eslint --fix 'src/**/*.ts' 'test/**/*.ts'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decentraland/core-libs.git",
    "directory": "libs/content-validator"
  },
  "keywords": [
    "decentraland",
    "content-validator",
    "catalyst"
  ],
  "dependencies": {
    "@dcl/block-indexer": "^1.1.2",
    "@dcl/content-hash-tree": "^1.1.4",
    "@dcl/hashing": "workspace:*",
    "@dcl/schemas": "^26.2.0",
    "@dcl/urn-resolver": "workspace:*",
    "@well-known-components/interfaces": "^1.4.3",
    "@well-known-components/thegraph-component": "^1.6.0",
    "ms": "^2.1.3",
    "p-queue": "^6.6.2"
  },
  "devDependencies": {
    "@dcl/eslint-config": "^3.1.0",
    "@types/ms": "^0.7.34",
    "@well-known-components/metrics": "^2.0.1",
    "@well-known-components/test-helpers": "^1.5.6",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "esbuild": "^0.27.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
