  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decentraland/core-libs.git",
    "directory": "libs/http-commons"
  },
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
